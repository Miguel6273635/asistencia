<mvc:View
    controllerName="com.mitsu.monitorasistencia.controller.Map"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:vbm="sap.ui.vbm">

    <Page
        showHeader="false"
        class="monitorPage">

        <content>
            <VBox class="pageContainer compactPage mapPage">

                <Breadcrumbs
                    currentLocationText="{map>/currentLocationText}"
                    class="sapUiTinyMarginBottom">

                    <Link
                        text="Inicio"
                        press=".onNavOverview" />

                    <Link
                        text="Mapa general"
                        press=".onNavMap"
                        visible="{= ${map>/mode} === 'zone'}" />

                </Breadcrumbs>

                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="mapTitleRow">

                    <VBox>
                        <Title
                            text="{map>/title}"
                            level="H1"
                            class="pageTitle" />

                        <Text
                            text="{map>/subtitle}"
                            class="pageSubtitle" />
                    </VBox>

                    <ObjectStatus
                        text="Datos SAP"
                        icon="sap-icon://database"
                        state="Success"
                        class="mapDemoBadge" />

                </HBox>

                <!-- FILTROS DEL MAPA -->
                <OverflowToolbar
                    class="filterBar mapToolbar sapUiSmallMarginTop sapUiSmallMarginBottom">

                    <VBox class="filterField mapZoneSelector">
                        <Label text="Vista geográfica" />

                        <Select
                            width="14rem"
                            selectedKey="{map>/currentZoneId}"
                            items="{map>/zoneOptions}"
                            change=".onZoneSelectorChange"
                            class="modernSelect">

                            <core:Item
                                key="{map>id}"
                                text="{map>name}" />

                        </Select>
                    </VBox>

                    <ToolbarSeparator />

                    <VBox class="filterField">
                        <Label text="Fecha desde" />

                        <DatePicker
                            id="mapDateFrom"
                            width="10rem"
                            value="{map>/dateFrom}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd/MM/yyyy"
                            placeholder="Desde" />
                    </VBox>

                    <VBox class="filterField">
                        <Label text="Fecha hasta" />

                        <DatePicker
                            id="mapDateTo"
                            width="10rem"
                            value="{map>/dateTo}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd/MM/yyyy"
                            placeholder="Hasta" />
                    </VBox>

                    <Button
                        text="Aplicar fechas"
                        icon="sap-icon://filter"
                        type="Emphasized"
                        press=".onApplyDateFilter" />

                    <ToolbarSeparator />

                    <ObjectStatus
                        text="{map>/summaryText}"
                        icon="sap-icon://map-2"
                        state="Information" />

                    <ToolbarSpacer />

                    <Button
                        text="Actualizar"
                        icon="sap-icon://refresh"
                        type="Emphasized"
                        press=".onRefreshLocations" />

                </OverflowToolbar>

                <!-- ESTADO DE LA CONSULTA -->
                <MessageStrip
                    text="{map>/errorText}"
                    type="Warning"
                    showIcon="true"
                    visible="{map>/hasError}"
                    class="sapUiSmallMarginBottom" />

                <MessageStrip
                    text="{map>/locationWarningText}"
                    type="Information"
                    showIcon="true"
                    visible="{map>/hasLocationWarning}"
                    class="sapUiSmallMarginBottom" />

                <HBox
                    alignItems="Center"
                    wrap="Wrap"
                    class="sapUiSmallMarginBottom">

                    <ObjectStatus
                        text="{map>/dateRangeText}"
                        icon="sap-icon://calendar"
                        state="Information"
                        class="sapUiSmallMarginEnd" />

                    <ObjectStatus
                        text="{map>/lastRefreshText}"
                        icon="sap-icon://synchronize"
                        state="Success"
                        class="sapUiSmallMarginEnd" />

                    <ObjectStatus
                        text="{= ${map>/withCoordinates} + ' con ubicación de entrada'}"
                        state="Success"
                        class="sapUiSmallMarginEnd" />

                    <ObjectStatus
                        text="{= ${map>/withoutCoordinates} + ' sin ubicación de entrada'}"
                        state="Warning" />

                </HBox>

                <l:Grid
                    defaultSpan="XL9 L8 M12 S12"
                    hSpacing="1"
                    vSpacing="1"
                    class="mapWorkspace">

                    <!-- MAPA -->
                    <Panel
                        headerText="{map>/mapPanelTitle}"
                        busy="{map>/loading}"
                        class="dashboardPanel mapCanvasPanel">

                        <content>
                            <vbm:GeoMap
                                id="geoMap"
                                width="100%"
                                height="34rem"
                                centerPosition="{map>/centerPosition}"
                                zoomlevel="{map>/zoomLevel}"
                                mapConfiguration="{map>/mapConfiguration}"
                                refMapLayerStack="MONITOR_MAP"
                                navcontrolVisible="true"
                                scaleVisible="true"
                                legendVisible="false"
                                class="mapGeoControl">

                                <vbm:vos>

                                    <!-- ZONAS -->
                                    <vbm:Spots
                                        items="{map>/zoneSpots}"
                                        visible="{= ${map>/mode} === 'general' &amp;&amp; !${map>/hasPersonSearch}}">

                                        <vbm:items>
                                            <vbm:Spot
                                                key="{map>id}"
                                                position="{map>position}"
                                                tooltip="{map>tooltip}"
                                                type="{map>type}"
                                                text="{map>text}"
                                                click=".onZoneSpotPress" />
                                        </vbm:items>

                                    </vbm:Spots>

                                    <!-- CENTROS -->
                                    <vbm:Spots
                                        items="{map>/currentCenters}"
                                        visible="{= ${map>/mode} === 'zone'}">

                                        <vbm:items>
                                            <vbm:Spot
                                                key="{map>id}"
                                                position="{map>position}"
                                                tooltip="{map>tooltip}"
                                                type="{map>type}"
                                                icon="{map>icon}"
                                                click=".onCenterSpotPress" />
                                        </vbm:items>

                                    </vbm:Spots>

                                    <!-- PERSONAL CON COORDENADAS -->
                                    <vbm:Spots
                                        items="{map>/currentPersonnelSpots}"
                                        visible="{= ${map>/mode} === 'zone' || ${map>/hasPersonSearch}}">

                                        <vbm:items>
                                            <vbm:Spot
                                                key="{map>employeeId}"
                                                position="{map>position}"
                                                tooltip="{map>tooltip}"
                                                type="{map>type}"
                                                text="{map>initials}"
                                                click=".onPersonnelSpotPress" />
                                        </vbm:items>

                                    </vbm:Spots>

                                </vbm:vos>
                            </vbm:GeoMap>
                        </content>

                    </Panel>

                    <!-- PANEL DE PERSONAL -->
                    <Panel
                        headerText="{map>/sidePanelTitle}"
                        busy="{map>/loading}"
                        class="dashboardPanel mapSidePanel">

                        <layoutData>
                            <l:GridData span="XL3 L4 M12 S12" />
                        </layoutData>

                        <content>
                            <VBox
                                id="mapSideContent"
                                class="mapSideContent">

                                <VBox class="mapSideStickyHeader">

                                <!-- CONTEOS -->
                                <HBox
                                    wrap="Wrap"
                                    class="mapLegend">

                                    <ObjectStatus
                                        text="{= 'Dentro de zona: ' + ${map>/withinZone}}"
                                        state="Success"
                                        active="true"
                                        inverted="{= ${map>/personStatusFilter} === 'inside'}"
                                        tooltip="Mostrar personas con registro dentro de zona"
                                        press=".onPersonnelStatusFilterPress"
                                        class="sapUiTinyMarginEnd mapPersonnelStatusFilter">
                                        <customData>
                                            <core:CustomData key="personStatusFilter" value="inside" />
                                        </customData>
                                    </ObjectStatus>

                                    <ObjectStatus
                                        text="{= 'Fuera de zona: ' + ${map>/outsideZone}}"
                                        state="Error"
                                        active="true"
                                        inverted="{= ${map>/personStatusFilter} === 'outside'}"
                                        tooltip="Mostrar personas con registro fuera de zona"
                                        press=".onPersonnelStatusFilterPress"
                                        class="sapUiTinyMarginEnd mapPersonnelStatusFilter">
                                        <customData>
                                            <core:CustomData key="personStatusFilter" value="outside" />
                                        </customData>
                                    </ObjectStatus>

                                    <ObjectStatus
                                        text="{= 'Sin información: ' + ${map>/withoutZoneInfo}}"
                                        state="None"
                                        active="true"
                                        inverted="{= ${map>/personStatusFilter} === 'missing'}"
                                        tooltip="Mostrar personas sin información de zona"
                                        press=".onPersonnelStatusFilterPress"
                                        class="mapPersonnelStatusFilter">
                                        <customData>
                                            <core:CustomData key="personStatusFilter" value="missing" />
                                        </customData>
                                    </ObjectStatus>

                                    <Button
                                        text="Quitar filtro"
                                        icon="sap-icon://decline"
                                        type="Transparent"
                                        visible="{map>/hasPersonnelStatusFilter}"
                                        press=".onClearPersonnelStatusFilter"
                                        class="mapPersonnelStatusClear" />

                                </HBox>

                                <!-- BÚSQUEDA DE PERSONAL -->
                                <VBox class="mapPersonnelSearchArea">
                                    <SearchField
                                        id="mapPersonnelSearch"
                                        value="{map>/personSearch}"
                                        placeholder="Buscar por nómina, correo o nombre"
                                        liveChange=".onPersonnelSearch"
                                        search=".onPersonnelSearch"
                                        width="100%"
                                        class="modernSearchField mapPersonnelSearch" />

                                    <Text
                                        text="{map>/personSearchResultText}"
                                        class="mapPersonnelSearchMeta" />
                                </VBox>

                                <!-- USUARIO SELECCIONADO: SIEMPRE ARRIBA -->
                                <VBox
                                    visible="{map>/hasSelectedPerson}"
                                    class="mapSelectedPersonCard">

                                    <HBox
                                        width="100%"
                                        justifyContent="SpaceBetween"
                                        alignItems="Start">

                                        <HBox
                                            alignItems="Center"
                                            class="mapSelectedPersonIdentity">

                                            <Avatar
                                                initials="{map>/selectedPerson/initials}"
                                                displayShape="Circle"
                                                displaySize="S"
                                                class="mapPersonAvatar" />

                                            <VBox class="sapUiTinyMarginBegin">
                                                <Label
                                                    text="Usuario seleccionado"
                                                    class="mapSelectedPersonEyebrow" />

                                                <Text
                                                    text="{map>/selectedPerson/name}"
                                                    wrapping="true"
                                                    class="mapPersonName" />

                                                <Text
                                                    text="{map>/selectedPerson/number}"
                                                    class="mapSelectedPersonNumber" />

                                                <Text
                                                    text="{map>/selectedPerson/email}"
                                                    visible="{= !!${map>/selectedPerson/email}}"
                                                    wrapping="true"
                                                    class="mapSelectedPersonEmail" />
                                            </VBox>
                                        </HBox>

                                        <Button
                                            icon="sap-icon://decline"
                                            type="Transparent"
                                            tooltip="Cerrar detalle"
                                            press=".onClearSelectedPerson"
                                            class="mapSelectedPersonClose" />

                                    </HBox>

                                    <HBox
                                        wrap="Wrap"
                                        alignItems="Center"
                                        class="mapSelectedPersonStatuses">

                                        <ObjectStatus
                                            text="{map>/selectedPerson/locationStatus}"
                                            state="{map>/selectedPerson/state}"
                                            icon="sap-icon://map-2" />

                                        <ObjectStatus
                                            text="{map>/selectedPerson/center}"
                                            icon="sap-icon://building"
                                            state="Information" />
                                    </HBox>

                                    <VBox class="mapSelectedPersonEvents">
                                        <HBox
                                            width="100%"
                                            alignItems="Center"
                                            justifyContent="SpaceBetween"
                                            class="mapSelectedPersonEventsHeader">
                                            <Label
                                                text="Estado de zona por marcación"
                                                class="mapSelectedPersonEventsTitle" />
                                            <Text
                                                text="{map>/selectedPerson/attendanceEventDateText}"
                                                class="mapSelectedPersonEventsDate" />
                                        </HBox>

                                        <FlexBox
                                            wrap="Wrap"
                                            items="{map>/selectedPerson/attendanceEvents}"
                                            class="mapSelectedPersonEventsGrid">
                                            <VBox class="mapSelectedPersonEventCard">
                                                <HBox
                                                    width="100%"
                                                    alignItems="Center"
                                                    class="mapSelectedPersonEventIdentity">
                                                    <core:Icon src="{map>icon}" />
                                                    <VBox>
                                                        <Text
                                                            text="{= ${map>label} + ' · ' + ${map>registerType}}"
                                                            class="mapSelectedPersonEventName" />
                                                        <Text
                                                            text="{map>dateTimeText}"
                                                            class="mapSelectedPersonEventTime" />
                                                    </VBox>
                                                </HBox>

                                                <ObjectStatus
                                                    text="{map>geoStatusText}"
                                                    state="{map>geoState}"
                                                    icon="{map>geoIcon}"
                                                    class="mapSelectedPersonEventStatus" />

                                                <Text
                                                    text="{map>coordinatesText}"
                                                    visible="{map>hasCoordinates}"
                                                    wrapping="true"
                                                    class="mapSelectedPersonEventMeta" />

                                                <Text
                                                    text="{map>channelText}"
                                                    visible="{= !!${map>channelText}}"
                                                    class="mapSelectedPersonEventMeta" />
                                            </VBox>
                                        </FlexBox>
                                    </VBox>

                                    <FlexBox
                                        wrap="Wrap"
                                        class="mapSelectedPersonFacts">

                                        <HBox
                                            alignItems="Start"
                                            class="mapSelectedPersonFact">
                                            <core:Icon src="sap-icon://history" />
                                            <VBox>
                                                <Label text="Inicio de labores" />
                                                <Text
                                                    text="{map>/selectedPerson/entryText}"
                                                    wrapping="true" />
                                                <Text
                                                    text="{map>/selectedPerson/entryChannel}"
                                                    visible="{= !!${map>/selectedPerson/entryChannel}}"
                                                    class="mapSelectedPersonFactMeta" />
                                            </VBox>
                                        </HBox>

                                        <HBox
                                            alignItems="Start"
                                            class="mapSelectedPersonFact">
                                            <core:Icon src="sap-icon://geographic-bubble-chart" />
                                            <VBox>
                                                <Label text="Ubicación de entrada" />
                                                <Text
                                                    text="{map>/selectedPerson/coordinatesText}"
                                                    wrapping="true" />
                                            </VBox>
                                        </HBox>

                                        <HBox
                                            alignItems="Start"
                                            class="mapSelectedPersonFact mapSelectedPersonFactWide">
                                            <core:Icon src="sap-icon://synchronize" />
                                            <VBox>
                                                <Label text="Origen del registro" />
                                                <Text
                                                    text="{map>/selectedPerson/entrySourceText}"
                                                    wrapping="true" />
                                            </VBox>
                                        </HBox>

                                    </FlexBox>

                                </VBox>

                                </VBox>

                                <!-- ENTRADAS FUERA DE ZONA -->
                                <VBox
                                    visible="{map>/showOutsideZoneSection}"
                                    class="mapOutsideZoneSection">

                                    <HBox
                                        width="100%"
                                        alignItems="Center"
                                        justifyContent="SpaceBetween"
                                        class="mapOutsideZoneHeader">

                                        <Title
                                            text="{map>/outsideZoneListTitle}"
                                            level="H4" />

                                        <ObjectStatus
                                            text="Revisar"
                                            state="Error"
                                            icon="sap-icon://warning" />

                                    </HBox>

                                    <List
                                        items="{map>/outsideZonePersonnel}"
                                        showSeparators="Inner"
                                        class="mapOutsideZoneList">

                                        <CustomListItem
                                            type="Active"
                                            highlight="Error"
                                            press=".onPersonnelListPress"
                                            class="mapOutsideZoneItem">

                                            <HBox
                                                width="100%"
                                                alignItems="Center"
                                                justifyContent="SpaceBetween">

                                                <HBox
                                                    alignItems="Center"
                                                    class="mapOutsideZoneIdentity">

                                                    <Avatar
                                                        initials="{map>initials}"
                                                        displayShape="Circle"
                                                        displaySize="S"
                                                        class="mapPersonAvatar" />

                                                    <VBox class="sapUiTinyMarginBegin">
                                                        <Text
                                                            text="{map>name}"
                                                            wrapping="true"
                                                            class="mapPersonName" />

                                                        <Text
                                                            text="{= ${map>number} + ' · ' + ${map>center}}"
                                                            wrapping="true"
                                                            class="zoneMeta" />

                                                        <Text
                                                            text="{map>entryText}"
                                                            class="mapUpdateText" />
                                                    </VBox>

                                                </HBox>

                                                <ObjectStatus
                                                    text="{map>locationStatus}"
                                                    state="Error"
                                                    icon="sap-icon://map-2"
                                                    class="mapOutsideZoneStatus" />

                                            </HBox>

                                        </CustomListItem>

                                    </List>

                                </VBox>

                                <!-- LISTADO GENERAL DE ZONAS -->
                                <List
                                    items="{map>/zoneSpots}"
                                    showSeparators="Inner"
                                    visible="{= ${map>/mode} === 'general' &amp;&amp; !${map>/hasPersonnelFilter}}"
                                    class="mapZoneList">

                                    <CustomListItem
                                        type="Active"
                                        press=".onZoneListPress"
                                        class="mapZoneListItem">

                                        <HBox
                                            width="100%"
                                            justifyContent="SpaceBetween"
                                            alignItems="Center">

                                            <HBox alignItems="Center">
                                                <Avatar
                                                    initials="{map>text}"
                                                    displayShape="Circle"
                                                    displaySize="S"
                                                    class="mapZoneAvatar" />

                                                <VBox class="sapUiTinyMarginBegin">
                                                    <Title
                                                        text="{map>name}"
                                                        level="H4" />

                                                    <Text
                                                        text="{= ${map>users} + ' personas'}"
                                                        class="zoneMeta" />
                                                </VBox>
                                            </HBox>

                                            <VBox alignItems="End">
                                                <ObjectNumber
                                                    number="{map>online}"
                                                    unit="con ubicación"
                                                    state="Success" />

                                                <core:Icon
                                                    src="sap-icon://navigation-right-arrow"
                                                    class="mapNavigateIcon" />
                                            </VBox>

                                        </HBox>
                                    </CustomListItem>

                                </List>

                                <!-- LISTADO DE PERSONAL -->
                                <List
                                    items="{map>/currentPersonnel}"
                                    showSeparators="Inner"
                                    visible="{= ${map>/mode} === 'zone' || ${map>/hasPersonnelFilter}}"
                                    noDataText="{map>/personNoDataText}"
                                    class="mapPersonnelList">

                                    <CustomListItem
                                        type="Active"
                                        press=".onPersonnelListPress"
                                        highlight="{= ${map>employeeId} === ${map>/selectedPerson/employeeId} ? 'Information' : 'None' }"
                                        class="mapPersonListItem">

                                        <VBox
                                            width="100%"
                                            class="sapUiTinyMarginTopBottom">

                                            <HBox
                                                width="100%"
                                                alignItems="Start"
                                                class="mapPersonIdentity">

                                                <Avatar
                                                    initials="{map>initials}"
                                                    displayShape="Circle"
                                                    displaySize="S"
                                                    class="mapPersonAvatar" />

                                                <VBox
                                                    width="100%"
                                                    class="sapUiTinyMarginBegin">

                                                    <Text
                                                        text="{map>name}"
                                                        wrapping="true"
                                                        class="mapPersonName" />

                                                    <Text
                                                        text="{= ${map>number} + ' · ' + ${map>center}}"
                                                        wrapping="true"
                                                        class="zoneMeta" />

                                                    <Text
                                                        text="{map>email}"
                                                        visible="{= !!${map>email}}"
                                                        wrapping="true"
                                                        class="mapPersonEmail" />

                                                    <Label
                                                        text="Inicio de labores"
                                                        class="sapUiTinyMarginTop" />

                                                    <Text
                                                        text="{map>entryText}"
                                                        wrapping="true"
                                                        class="mapUpdateText" />

                                                    <Text
                                                        text="{map>entryChannel}"
                                                        class="zoneMeta" />

                                                </VBox>
                                            </HBox>

                                            <HBox
                                                width="100%"
                                                alignItems="Center"
                                                justifyContent="SpaceBetween"
                                                class="sapUiTinyMarginTop">

                                                <ObjectStatus
                                                    text="{map>locationStatus}"
                                                    state="{map>state}"
                                                    class="mapPersonStatus" />

                                                <ObjectStatus
                                                    text="{= ${map>hasCoordinates} ? 'Con ubicación de entrada' : 'Sin ubicación de entrada'}"
                                                    state="{= ${map>hasCoordinates} ? 'Success' : 'Warning'}" />

                                            </HBox>

                                            <HBox
                                                alignItems="Center"
                                                class="sapUiTinyMarginTop">

                                                <core:Icon
                                                    src="sap-icon://map-2"
                                                    class="sapUiTinyMarginEnd" />

                                                <Text
                                                    text="{map>coordinatesText}"
                                                    wrapping="true"
                                                    class="zoneMeta" />
                                            </HBox>

                                        </VBox>
                                    </CustomListItem>

                                </List>

                            </VBox>
                        </content>
                    </Panel>

                </l:Grid>

            </VBox>
        </content>
    </Page>
</mvc:View>
