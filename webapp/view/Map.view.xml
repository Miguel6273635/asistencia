
<mvc:View
    controllerName="com.mitsu.monitorasistencia.controller.Map"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:vbm="sap.ui.vbm">

    <Page
        showHeader="false"
        class="monitorPage">

        <content>
            <VBox class="pageContainer compactPage mapPage">

                <Breadcrumbs
                    currentLocationText="{map>/currentLocationText}"
                    class="sapUiTinyMarginBottom">

                    <Link
                        text="Inicio"
                        press=".onNavOverview" />

                    <Link
                        text="Mapa general"
                        press=".onNavMap"
                        visible="{= ${map>/mode} === 'zone'}" />

                </Breadcrumbs>

                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="mapTitleRow">

                    <VBox>
                        <Title
                            text="{map>/title}"
                            level="H1"
                            class="pageTitle" />

                        <Text
                            text="{map>/subtitle}"
                            class="pageSubtitle" />
                    </VBox>

                    <ObjectStatus
                        text="Datos SAP"
                        icon="sap-icon://database"
                        state="Success"
                        class="mapDemoBadge" />

                </HBox>

                <!-- FILTROS DEL MAPA -->
                <OverflowToolbar
                    class="filterBar mapToolbar sapUiSmallMarginTop sapUiSmallMarginBottom">

                    <VBox class="filterField mapZoneSelector">
                        <Label text="Vista geográfica" />

                        <Select
                            width="14rem"
                            selectedKey="{map>/currentZoneId}"
                            items="{map>/zoneOptions}"
                            change=".onZoneSelectorChange"
                            class="modernSelect">

                            <core:Item
                                key="{map>id}"
                                text="{map>name}" />

                        </Select>
                    </VBox>

                    <ToolbarSeparator />

                    <VBox class="filterField">
                        <Label text="Fecha desde" />

                        <DatePicker
                            id="mapDateFrom"
                            width="10rem"
                            value="{map>/dateFrom}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd/MM/yyyy"
                            placeholder="Desde" />
                    </VBox>

                    <VBox class="filterField">
                        <Label text="Fecha hasta" />

                        <DatePicker
                            id="mapDateTo"
                            width="10rem"
                            value="{map>/dateTo}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd/MM/yyyy"
                            placeholder="Hasta" />
                    </VBox>

                    <Button
                        text="Aplicar fechas"
                        icon="sap-icon://filter"
                        type="Emphasized"
                        press=".onApplyDateFilter" />

                    <ToolbarSeparator />

                    <ObjectStatus
                        text="{map>/summaryText}"
                        icon="sap-icon://map-2"
                        state="Information" />

                    <ToolbarSpacer />

                    <Button
                        text="Actualizar"
                        icon="sap-icon://refresh"
                        type="Emphasized"
                        press=".onRefreshLocations" />

                </OverflowToolbar>

                <!-- ESTADO DE LA CONSULTA -->
                <MessageStrip
                    text="{map>/errorText}"
                    type="Warning"
                    showIcon="true"
                    visible="{map>/hasError}"
                    class="sapUiSmallMarginBottom" />

                <HBox
                    alignItems="Center"
                    wrap="Wrap"
                    class="sapUiSmallMarginBottom">

                    <ObjectStatus
                        text="{map>/dateRangeText}"
                        icon="sap-icon://calendar"
                        state="Information"
                        class="sapUiSmallMarginEnd" />

                    <ObjectStatus
                        text="{map>/lastRefreshText}"
                        icon="sap-icon://synchronize"
                        state="Success"
                        class="sapUiSmallMarginEnd" />

                    <ObjectStatus
                        text="{= ${map>/withCoordinates} + ' con coordenadas'}"
                        state="Success"
                        class="sapUiSmallMarginEnd" />

                    <ObjectStatus
                        text="{= ${map>/withoutCoordinates} + ' sin coordenadas'}"
                        state="Warning" />

                </HBox>

                <l:Grid
                    defaultSpan="XL9 L8 M12 S12"
                    hSpacing="1"
                    vSpacing="1"
                    class="mapWorkspace">

                    <!-- MAPA -->
                    <Panel
                        headerText="{map>/mapPanelTitle}"
                        busy="{map>/loading}"
                        class="dashboardPanel mapCanvasPanel">

                        <content>
                            <vbm:GeoMap
                                id="geoMap"
                                width="100%"
                                height="34rem"
                                centerPosition="{map>/centerPosition}"
                                zoomlevel="{map>/zoomLevel}"
                                mapConfiguration="{map>/mapConfiguration}"
                                refMapLayerStack="MONITOR_MAP"
                                navcontrolVisible="true"
                                scaleVisible="true"
                                legendVisible="false"
                                class="mapGeoControl">

                                <vbm:vos>

                                    <!-- ZONAS -->
                                    <vbm:Spots
                                        items="{map>/zoneSpots}"
                                        visible="{= ${map>/mode} === 'general'}">

                                        <vbm:items>
                                            <vbm:Spot
                                                key="{map>id}"
                                                position="{map>position}"
                                                tooltip="{map>tooltip}"
                                                type="{map>type}"
                                                text="{map>text}"
                                                click=".onZoneSpotPress" />
                                        </vbm:items>

                                    </vbm:Spots>

                                    <!-- CENTROS -->
                                    <vbm:Spots
                                        items="{map>/currentCenters}"
                                        visible="{= ${map>/mode} === 'zone'}">

                                        <vbm:items>
                                            <vbm:Spot
                                                key="{map>id}"
                                                position="{map>position}"
                                                tooltip="{map>tooltip}"
                                                type="{map>type}"
                                                icon="{map>icon}"
                                                click=".onCenterSpotPress" />
                                        </vbm:items>

                                    </vbm:Spots>

                                    <!-- PERSONAL CON COORDENADAS -->
                                    <vbm:Spots
                                        items="{map>/currentPersonnelSpots}"
                                        visible="{= ${map>/mode} === 'zone'}">

                                        <vbm:items>
                                            <vbm:Spot
                                                key="{map>employeeId}"
                                                position="{map>position}"
                                                tooltip="{map>tooltip}"
                                                type="{map>type}"
                                                text="{map>initials}"
                                                click=".onPersonnelSpotPress" />
                                        </vbm:items>

                                    </vbm:Spots>

                                </vbm:vos>
                            </vbm:GeoMap>
                        </content>

                    </Panel>

                    <!-- PANEL DE PERSONAL -->
                    <Panel
                        headerText="{map>/sidePanelTitle}"
                        busy="{map>/loading}"
                        class="dashboardPanel mapSidePanel">

                        <layoutData>
                            <l:GridData span="XL3 L4 M12 S12" />
                        </layoutData>

                        <content>
                            <VBox class="mapSideContent">

                                <!-- CONTEOS -->
                                <HBox
                                    wrap="Wrap"
                                    class="mapLegend">

                                    <ObjectStatus
                                        text="{= 'Dentro de zona: ' + ${map>/withinZone}}"
                                        state="Success"
                                        class="sapUiTinyMarginEnd" />

                                    <ObjectStatus
                                        text="{= 'Fuera de zona: ' + ${map>/outsideZone}}"
                                        state="Error"
                                        class="sapUiTinyMarginEnd" />

                                    <ObjectStatus
                                        text="{= 'Sin información: ' + ${map>/withoutZoneInfo}}"
                                        state="None" />

                                </HBox>

                                <!-- LISTADO GENERAL DE ZONAS -->
                                <List
                                    items="{map>/zoneSpots}"
                                    showSeparators="Inner"
                                    visible="{= ${map>/mode} === 'general'}"
                                    class="mapZoneList">

                                    <CustomListItem
                                        type="Active"
                                        press=".onZoneListPress"
                                        class="mapZoneListItem">

                                        <HBox
                                            width="100%"
                                            justifyContent="SpaceBetween"
                                            alignItems="Center">

                                            <HBox alignItems="Center">
                                                <Avatar
                                                    initials="{map>text}"
                                                    displayShape="Circle"
                                                    displaySize="S"
                                                    class="mapZoneAvatar" />

                                                <VBox class="sapUiTinyMarginBegin">
                                                    <Title
                                                        text="{map>name}"
                                                        level="H4" />

                                                    <Text
                                                        text="{= ${map>users} + ' personas'}"
                                                        class="zoneMeta" />
                                                </VBox>
                                            </HBox>

                                            <VBox alignItems="End">
                                                <ObjectNumber
                                                    number="{map>online}"
                                                    unit="con ubicación"
                                                    state="Success" />

                                                <core:Icon
                                                    src="sap-icon://navigation-right-arrow"
                                                    class="mapNavigateIcon" />
                                            </VBox>

                                        </HBox>
                                    </CustomListItem>

                                </List>

                                <!-- LISTADO DE PERSONAL -->
                                <List
                                    items="{map>/currentPersonnel}"
                                    showSeparators="Inner"
                                    visible="{= ${map>/mode} === 'zone'}"
                                    noDataText="No se recibió personal en este rango"
                                    class="mapPersonnelList">

                                    <CustomListItem
                                        type="Active"
                                        press=".onPersonnelListPress"
                                        class="mapPersonListItem">

                                        <VBox
                                            width="100%"
                                            class="sapUiTinyMarginTopBottom">

                                            <HBox
                                                width="100%"
                                                alignItems="Start"
                                                class="mapPersonIdentity">

                                                <Avatar
                                                    initials="{map>initials}"
                                                    displayShape="Circle"
                                                    displaySize="S"
                                                    class="mapPersonAvatar" />

                                                <VBox
                                                    width="100%"
                                                    class="sapUiTinyMarginBegin">

                                                    <Text
                                                        text="{map>name}"
                                                        wrapping="true"
                                                        class="mapPersonName" />

                                                    <Text
                                                        text="{= ${map>number} + ' · ' + ${map>center}}"
                                                        wrapping="true"
                                                        class="zoneMeta" />

                                                    <Label
                                                        text="Último check"
                                                        class="sapUiTinyMarginTop" />

                                                    <Text
                                                        text="{map>lastCheck}"
                                                        wrapping="true"
                                                        class="mapUpdateText" />

                                                    <Text
                                                        text="{map>lastCheckType}"
                                                        class="zoneMeta" />

                                                </VBox>
                                            </HBox>

                                            <HBox
                                                width="100%"
                                                alignItems="Center"
                                                justifyContent="SpaceBetween"
                                                class="sapUiTinyMarginTop">

                                                <ObjectStatus
                                                    text="{map>locationStatus}"
                                                    state="{map>state}"
                                                    class="mapPersonStatus" />

                                                <ObjectStatus
                                                    text="{= ${map>hasCoordinates} ? 'Con ubicación' : 'Sin ubicación'}"
                                                    state="{= ${map>hasCoordinates} ? 'Success' : 'Warning'}" />

                                            </HBox>

                                            <HBox
                                                alignItems="Center"
                                                class="sapUiTinyMarginTop">

                                                <core:Icon
                                                    src="sap-icon://map-2"
                                                    class="sapUiTinyMarginEnd" />

                                                <Text
                                                    text="{map>coordinatesText}"
                                                    wrapping="true"
                                                    class="zoneMeta" />
                                            </HBox>

                                        </VBox>
                                    </CustomListItem>

                                </List>

                                <!-- DETALLE DEL PERSONAL SELECCIONADO -->
                                <VBox
                                    visible="{map>/hasSelectedPerson}"
                                    class="mapSelectedPerson">

                                    <Title
                                        text="Detalle del personal"
                                        level="H4"
                                        class="sapUiTinyMarginBottom" />

                                    <HBox
                                        alignItems="Center"
                                        justifyContent="SpaceBetween">

                                        <HBox alignItems="Center">
                                            <Avatar
                                                initials="{map>/selectedPerson/initials}"
                                                displaySize="S"
                                                class="mapSelectedAvatar" />

                                            <VBox class="sapUiTinyMarginBegin">
                                                <Title
                                                    text="{map>/selectedPerson/name}"
                                                    level="H4" />

                                                <Text
                                                    text="{map>/selectedPerson/number}" />
                                            </VBox>
                                        </HBox>

                                        <ObjectStatus
                                            text="{map>/selectedPerson/locationStatus}"
                                            state="{map>/selectedPerson/state}" />

                                    </HBox>

                                    <VBox class="sapUiSmallMarginTop">

                                        <Label text="Centro de trabajo" />
                                        <Text
                                            text="{map>/selectedPerson/center}"
                                            wrapping="true" />

                                        <Label
                                            text="Último check"
                                            class="sapUiSmallMarginTop" />

                                        <ObjectStatus
                                            text="{map>/selectedPerson/lastCheck}"
                                            icon="sap-icon://history"
                                            state="Information" />

                                        <Text
                                            text="{map>/selectedPerson/lastCheckType}" />

                                        <Label
                                            text="Ubicación registrada"
                                            class="sapUiSmallMarginTop" />

                                        <Text
                                            text="{map>/selectedPerson/coordinatesText}"
                                            wrapping="true" />

                                        <Label
                                            text="Última señal de ubicación"
                                            class="sapUiSmallMarginTop" />

                                        <Text
                                            text="{map>/selectedPerson/lastSignal}"
                                            wrapping="true" />

                                    </VBox>

                                </VBox>

                            </VBox>
                        </content>
                    </Panel>

                </l:Grid>

            </VBox>
        </content>
    </Page>
</mvc:View>
