<mvc:View
    controllerName="com.mitsu.monitorasistencia.controller.Centers"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
    <Page showHeader="false" class="monitorPage">
        <content>
            <VBox class="pageContainer compactPage centersPage">
                <Breadcrumbs currentLocationText="Centros de trabajo" class="sapUiTinyMarginBottom"><Link text="Resumen" press=".onNavOverview" /></Breadcrumbs>
                <Title text="Centros de trabajo" level="H1" class="pageTitle" />
                <Text text="Consulta por zona, periodo y centro" class="pageSubtitle" />

                <OverflowToolbar class="filterBar sapUiSmallMarginTop sapUiSmallMarginBottom">
                    <VBox class="filterField"><Label text="Zona" /><Select id="zoneSelect" width="13rem" selectedKey="{view>/zoneId}" change=".onFilterChange" items="{attendance>/zones}"><core:Item key="{attendance>id}" text="{attendance>name}" /></Select></VBox>
                    <VBox class="filterField"><Label text="Periodo" /><Select width="9rem" selectedKey="{view>/granularity}" change=".onPeriodChange"><core:Item key="week" text="Semana" /><core:Item key="month" text="Mes" /><core:Item key="year" text="Año" /></Select></VBox>
                    <VBox class="filterField"><Label text="Fecha de referencia" /><DatePicker value="{view>/referenceDate}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" width="12rem" change=".onPeriodChange" /></VBox>
                    <ObjectStatus text="{view>/periodLabel}" state="Information" inverted="true" />
                    <VBox class="filterField"><Label text="Buscar centro" /><SearchField width="15rem" placeholder="Nombre o código" liveChange=".onSearch" class="modernSearchField" /></VBox>
                </OverflowToolbar>

                <FlexBox wrap="Wrap" class="kpiRow centersCompactKpis">
                    <VBox class="kpiCard kpiBlue"><HBox alignItems="Center"><core:Icon src="sap-icon://building" class="kpiIcon blue" /><VBox><Text text="Centros con registros" /><ObjectNumber number="{view>/stats/centers}" /></VBox></HBox></VBox>
                    <VBox class="kpiCard kpiAmber"><HBox alignItems="Center"><core:Icon src="sap-icon://alert" class="kpiIcon amber" /><VBox><Text text="Incidencias registradas" /><ObjectNumber number="{view>/stats/incidents}" state="Warning" /></VBox></HBox></VBox>
                </FlexBox>

                <Panel headerText="Detalle por centro" class="dashboardPanel sapUiSmallMarginTop centersDetailPanel">
                    <content>
                        <ScrollContainer vertical="true" horizontal="false" focusable="true" class="tableScrollContainer centersTableScroll">
                            <Table id="centersTable" items="{view>/centers}" class="scrollTable" noDataText="No hay centros para los filtros seleccionados">
                                <columns>
                                    <Column><Text text="Centro de trabajo" /></Column>
                                    <Column hAlign="End"><Text text="Usuarios con registro" wrapping="true" /></Column>
                                    <Column hAlign="End"><Text text="Presentes" /></Column>
                                    <Column hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="Retardos" /></Column>
                                    <Column hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="Ausencias" /></Column>
                                    <Column width="13rem"><Text text="% asistencia" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{view>name}" text="{view>code}" />
                                            <ObjectNumber number="{view>users}" />
                                            <ObjectNumber number="{view>present}" state="Success" />
                                            <ObjectNumber number="{view>late}" state="Warning" />
                                            <ObjectNumber number="{view>absent}" state="Error" />
                                            <ProgressIndicator percentValue="{view>attendance}" displayValue="{view>attendance}%" state="{path:'view>attendance', formatter:'.formatter.percentState'}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </ScrollContainer>
                    </content>
                </Panel>

                <Panel headerText="Asistencia por centro" class="dashboardPanel sapUiSmallMarginTop centersAttendancePanel">
                    <content>
                        <viz:VizFrame id="centerRankingChart" vizType="bar" width="100%" height="21rem">
                            <viz:dataset>
                                <viz.data:FlattenedDataset data="{view>/centers}">
                                    <viz.data:dimensions><viz.data:DimensionDefinition name="Centro" value="{view>name}" /></viz.data:dimensions>
                                    <viz.data:measures><viz.data:MeasureDefinition name="Asistencia" value="{view>attendance}" /></viz.data:measures>
                                </viz.data:FlattenedDataset>
                            </viz:dataset>
                            <viz:feeds><viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Asistencia" /><viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Centro" /></viz:feeds>
                        </viz:VizFrame>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
