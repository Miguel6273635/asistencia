<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <ResponsivePopover
        id="personDetailPopover"
        title="Detalle del personal"
        placement="Auto"
        contentWidth="23rem"
        horizontalScrolling="false"
        verticalScrolling="true"
        class="mapPersonPopover">
        <content>
            <VBox class="mapPersonPopoverContent">
                <HBox alignItems="Center" class="mapPersonPopoverHeader">
                    <Avatar
                        initials="{map>/selectedPerson/initials}"
                        displayShape="Circle"
                        displaySize="M"
                        class="mapPersonPopoverAvatar" />
                    <VBox class="mapPersonPopoverIdentity">
                        <Title text="{map>/selectedPerson/name}" level="H3" />
                        <Text text="{map>/selectedPerson/number}" class="mapPersonPopoverNumber" />
                        <Text text="{map>/selectedPerson/role}" class="mapPersonPopoverRole" />
                    </VBox>
                </HBox>

                <ObjectStatus
                    text="{map>/selectedPerson/locationStatus}"
                    state="{map>/selectedPerson/state}"
                    icon="sap-icon://map-2"
                    class="mapPersonPopoverStatus" />

                <VBox class="mapPersonPopoverDetails">
                    <HBox alignItems="Start" class="mapPersonPopoverField">
                        <core:Icon src="sap-icon://building" />
                        <VBox>
                            <Label text="Centro de trabajo" />
                            <Text text="{map>/selectedPerson/center}" wrapping="true" />
                        </VBox>
                    </HBox>

                    <HBox alignItems="Start" class="mapPersonPopoverField">
                        <core:Icon src="sap-icon://geographic-bubble-chart" />
                        <VBox>
                            <Label text="Ubicación registrada" />
                            <Text text="{map>/selectedPerson/coordinatesText}" wrapping="true" />
                        </VBox>
                    </HBox>

                    <HBox alignItems="Start" class="mapPersonPopoverField">
                        <core:Icon src="sap-icon://history" />
                        <VBox>
                            <Label text="Última señal de ubicación" />
                            <Text text="{map>/selectedPerson/lastLocation}" wrapping="true" />
                        </VBox>
                    </HBox>

                    <HBox alignItems="Start" class="mapPersonPopoverField">
                        <core:Icon src="sap-icon://measure" />
                        <VBox>
                            <Label text="Distancia al centro" />
                            <Text text="{map>/selectedPerson/accuracy}" wrapping="true" />
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </content>
        <endButton>
            <Button text="Cerrar" press=".onClosePersonPopover" />
        </endButton>
    </ResponsivePopover>
</core:FragmentDefinition>
