<mvc:View
    controllerName="com.mitsu.monitorasistencia.controller.Overview"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
    <Page showHeader="false" class="monitorPage">
        <content>
            <VBox class="pageContainer compactPage overviewPage">
                <Breadcrumbs currentLocationText="Resumen por zona" class="sapUiTinyMarginBottom">
                    <Link text="Inicio" enabled="false" />
                </Breadcrumbs>
                <Title text="Resumen por zona" level="H1" class="pageTitle" />
                <Text text="Eficiencia operativa, incidencias y centros que requieren atención" class="pageSubtitle" />

                <OverflowToolbar class="filterBar sapUiSmallMarginTop sapUiSmallMarginBottom">
                    <VBox class="filterField">
                        <Label text="Periodo" />
                        <Select width="10rem" selectedKey="{view>/granularity}" change=".onGranularityChange">
                            <core:Item key="day" text="Día" />
                            <core:Item key="week" text="Semana" />
                            <core:Item key="month" text="Mes" />
                            <core:Item key="year" text="Año" />
                        </Select>
                    </VBox>
                    <VBox class="filterField" visible="{= ${view>/granularity} === 'day' }">
                        <Label text="Fecha" />
                        <DatePicker value="{view>/referenceDate}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" width="11rem" change=".onReferenceDateChange" />
                    </VBox>
                    <VBox class="filterField" visible="{= ${view>/granularity} === 'week' }">
                        <Label text="Desde" />
                        <DatePicker value="{view>/dateFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" width="11rem" change=".onWeekRangeChange" />
                    </VBox>
                    <VBox class="filterField" visible="{= ${view>/granularity} === 'week' }">
                        <Label text="Hasta" />
                        <DatePicker value="{view>/dateTo}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" width="11rem" change=".onWeekRangeChange" />
                    </VBox>
                    <VBox class="filterField" visible="{= ${view>/granularity} === 'month' }">
                        <Label text="Mes" />
                        <Select width="11rem" selectedKey="{view>/referenceMonth}" change=".onReferenceMonthChange" items="{view>/monthOptions}">
                            <core:Item key="{view>key}" text="{view>text}" />
                        </Select>
                    </VBox>
                    <VBox class="filterField" visible="{= ${view>/granularity} === 'month' || ${view>/granularity} === 'year' }">
                        <Label text="Año" />
                        <Select width="9rem" selectedKey="{view>/referenceYear}" change=".onReferenceYearChange" items="{view>/yearOptions}">
                            <core:Item key="{view>key}" text="{view>text}" />
                        </Select>
                    </VBox>
                    <VBox class="filterField">
                        <Label text="Horario" />
                        <ComboBox width="18rem" placeholder="Todos los horarios" selectedKey="{view>/scheduleId}" selectionChange=".onPeriodChange" items="{attendance>/schedules}" showSecondaryValues="true" filterSecondaryValues="true">
                            <core:ListItem key="{attendance>id}" text="{attendance>name}" additionalText="{attendance>shortDescription}" />
                        </ComboBox>
                    </VBox>
                    <VBox class="filterField">
                        <Label text="Estatus" />
                        <Select width="12rem" selectedKey="{view>/status}" change=".onPeriodChange">
                            <core:Item key="all" text="Todos" />
                            <core:Item key="present" text="Presentes" />
                            <core:Item key="late" text="Retardos" />
                            <core:Item key="absent" text="Ausencias" />
                            <core:Item key="outside" text="Fuera de zona" />
                        </Select>
                    </VBox>
                    <ObjectStatus text="{view>/periodLabel}" state="Information" inverted="true" />
                    <ToolbarSpacer />
                    <Button text="Aplicar filtros" type="Emphasized" icon="sap-icon://filter" press=".onApplyFilters" />
                </OverflowToolbar>

                <List items="{view>/zoneSummaries}" showSeparators="None" class="zoneCardList">
                    <CustomListItem type="Active" press=".onZonePress" class="zoneSummaryCard">
                        <customData><core:CustomData key="zoneId" value="{view>zoneId}" /></customData>
                        <VBox width="100%">
                            <HBox justifyContent="SpaceBetween" alignItems="Start">
                                <VBox><Title text="{view>name}" level="H4" /><Text text="{view>meta}" class="zoneMeta" /></VBox>
                                <ObjectStatus text="{view>riskText}" state="{view>state}" inverted="true" />
                            </HBox>
                            <HBox justifyContent="SpaceBetween" alignItems="End" class="zoneMetricRow">
                                <VBox><ObjectNumber number="{view>attendance}" unit="% asistencia" state="{view>state}" /><Text text="{view>incidentSummary}" class="zoneIncidentSummary" /></VBox>
                                <ObjectStatus text="{view>inefficiencyText}" state="{view>state}" />
                            </HBox>
                        </VBox>
                    </CustomListItem>
                </List>

                <l:Grid defaultSpan="XL8 L8 M12 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMarginTop overviewPrimaryGrid">
                    <Panel headerText="Ineficiencia por zona (%)" class="dashboardPanel inefficiencyPanel overviewBalancedPanel">
                        <content>
                            <viz:VizFrame id="inefficiencyChart" vizType="stacked_bar" width="100%" height="14rem" selectData=".onZoneChartSelect" class="overviewInefficiencyChart">
                                <viz:dataset>
                                    <viz.data:FlattenedDataset data="{view>/zoneInefficiency}">
                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition name="Zona" value="{view>zone}" />
                                        </viz.data:dimensions>
                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition name="Ausencias" value="{view>absentRate}" />
                                            <viz.data:MeasureDefinition name="Retardos" value="{view>lateRate}" />
                                        </viz.data:measures>
                                    </viz.data:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Ausencias,Retardos" />
                                    <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Zona" />
                                </viz:feeds>
                            </viz:VizFrame>
                            <HBox alignItems="Center" class="chartHint">
                                <core:Icon src="sap-icon://hint" class="sapUiTinyMarginEnd" />
                                <Text text="Cada barra suma retardos y ausencias; su longitud total representa la ineficiencia de la zona." />
                            </HBox>
                        </content>
                    </Panel>

                    <VBox class="overviewSideColumn">
                        <layoutData><l:GridData span="XL4 L4 M12 S12" /></layoutData>
                        <Panel headerText="Revisión de incidencias" class="dashboardPanel incidentReviewPanel">
                            <content>
                                <VBox class="incidentReviewList">
                                    <HBox alignItems="Center" class="incidentReviewCard incidentReviewLate">
                                        <core:Icon src="sap-icon://lateness" class="incidentReviewIcon" />
                                        <VBox class="incidentReviewBody">
                                            <Title text="Retardos" level="H5" />
                                            <Text text="Justificaciones pendientes de revisión" />
                                        </VBox>
                                        <ObjectNumber number="{view>/lateReviewCount}" state="Warning" class="incidentReviewCount" />
                                        <Button text="Revisar" icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onLateReviewPress" />
                                    </HBox>
                                    <HBox alignItems="Center" class="incidentReviewCard incidentReviewEarly">
                                        <core:Icon src="sap-icon://log" class="incidentReviewIcon" />
                                        <VBox class="incidentReviewBody">
                                            <Title text="Salidas anticipadas" level="H5" />
                                            <Text text="Justificaciones pendientes de revisión" />
                                        </VBox>
                                        <ObjectNumber number="{view>/earlyExitReviewCount}" state="Error" class="incidentReviewCount" />
                                        <Button text="Revisar" icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onEarlyExitReviewPress" />
                                    </HBox>
                                    <HBox alignItems="Center" class="incidentReviewCard incidentReviewFourthLate">
                                        <core:Icon src="sap-icon://number-sign" class="incidentReviewIcon" />
                                        <VBox class="incidentReviewBody">
                                            <Title text="4.º retardo" level="H5" />
                                            <Text text="Casos pendientes de revisión por RH" />
                                        </VBox>
                                        <ObjectNumber number="{view>/fourthLateReviewCount}" state="Information" class="incidentReviewCount" />
                                        <Button text="Revisar" icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onFourthLateReviewPress" />
                                    </HBox>
                                    <HBox alignItems="Center" class="incidentReviewCard incidentReviewNoAttendance">
                                        <core:Icon src="sap-icon://employee-rejections" class="incidentReviewIcon" />
                                        <VBox class="incidentReviewBody">
                                            <Title text="Inasistencias" level="H5" />
                                            <Text text="Sin ninguna marcación en el periodo" />
                                        </VBox>
                                        <ObjectNumber number="{view>/noAttendanceReviewCount}" state="Error" class="incidentReviewCount" />
                                        <Button text="Revisar" icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onNoAttendanceReviewPress" />
                                    </HBox>
                                </VBox>
                            </content>
                        </Panel>
                    </VBox>
                </l:Grid>

                <l:Grid defaultSpan="XL12 L12 M12 S12" hSpacing="1" vSpacing="1" class="sapUiTinyMarginTop overviewSecondaryGrid">
                    <Panel headerText="{= 'Tendencia de incidencias · ' + ${view>/periodLabel}}" class="dashboardPanel incidentTrendPanel overviewBalancedPanel">
                        <content>
                            <HBox
                                wrap="Wrap"
                                alignItems="Center"
                                class="incidentLegendButtons">

                                <Button
                                    text="{= 'Retardados · ' + ${view>/incidentCounts/late}}"
                                    icon="sap-icon://lateness"
                                    type="Transparent"
                                    enabled="{= ${view>/incidentCounts/late} &gt; 0}"
                                    tooltip="Ver usuarios que presentaron retardos"
                                    press=".onIncidentLegendPress"
                                    class="incidentLegendButton incidentLegendLate">
                                    <customData>
                                        <core:CustomData key="incidentType" value="late" />
                                    </customData>
                                </Button>

                                <Button
                                    text="{= 'Ausencias · ' + ${view>/incidentCounts/absent}}"
                                    icon="sap-icon://decline"
                                    type="Transparent"
                                    enabled="{= ${view>/incidentCounts/absent} &gt; 0}"
                                    tooltip="Ver usuarios que presentaron ausencias"
                                    press=".onIncidentLegendPress"
                                    class="incidentLegendButton incidentLegendAbsent">
                                    <customData>
                                        <core:CustomData key="incidentType" value="absent" />
                                    </customData>
                                </Button>

                                <Button
                                    text="{= 'Fuera de zona · ' + ${view>/incidentCounts/outside}}"
                                    icon="sap-icon://map-2"
                                    type="Transparent"
                                    enabled="{= ${view>/incidentCounts/outside} &gt; 0}"
                                    tooltip="Ver usuarios que registraron fuera de zona"
                                    press=".onIncidentLegendPress"
                                    class="incidentLegendButton incidentLegendOutside">
                                    <customData>
                                        <core:CustomData key="incidentType" value="outside" />
                                    </customData>
                                </Button>
                            </HBox>

                            <viz:VizFrame id="incidentTrendChart" vizType="line" width="100%" height="10.75rem" class="overviewIncidentTrendChart">
                                <viz:dataset>
                                    <viz.data:FlattenedDataset data="{view>/incidentTrend}">
                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition name="Día" value="{view>day}" />
                                        </viz.data:dimensions>
                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition name="Retardos" value="{view>late}" />
                                            <viz.data:MeasureDefinition name="Ausencias" value="{view>absent}" />
                                            <viz.data:MeasureDefinition name="Fuera de zona" value="{view>outsideZone}" />
                                        </viz.data:measures>
                                    </viz.data:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Retardos,Ausencias,Fuera de zona" />
                                    <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Día" />
                                </viz:feeds>
                            </viz:VizFrame>
                        </content>
                    </Panel>

                </l:Grid>
            </VBox>
        </content>
    </Page>
</mvc:View>
