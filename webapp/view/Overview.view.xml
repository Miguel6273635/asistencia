<mvc:View controllerName="com.mitsu.monitorasistencia.controller.Overview"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout" xmlns:viz="sap.viz.ui5.controls"
  xmlns:viz.data="sap.viz.ui5.data" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
  <Page showHeader="false" class="monitorPage">
    <content>
      <VBox class="pageContainer compactPage overviewPage">
        <Breadcrumbs currentLocationText="Resumen por zona" class="sapUiTinyMarginBottom">
          <Link text="Inicio" enabled="false"/>
        </Breadcrumbs>
        <Title text="Resumen por zona" level="H1" class="pageTitle"/>
        <Text text="Asistencia e incidencias por zona" class="pageSubtitle"/>
        <OverflowToolbar class="filterBar sapUiSmallMarginTop sapUiSmallMarginBottom">
          <VBox class="filterField">
            <Label text="Periodo"/>
            <Select width="10rem" selectedKey="{view>/granularity}" change=".onPeriodChange">
              <core:Item key="week" text="Semana"/>
              <core:Item key="month" text="Mes"/>
              <core:Item key="year" text="Año"/>
            </Select>
          </VBox>
          <VBox class="filterField">
            <Label text="Fecha de referencia"/>
            <Button text="{view>/selectionLabel}" icon="sap-icon://calendar" press=".onOpenPeriodPicker" width="17rem" class="monitorCalendarTrigger"/>
          </VBox>
          <ObjectStatus text="{view>/periodLabel}" state="Information" inverted="true"/>
          <ToolbarSpacer/>
          <Button text="Aplicar filtros" type="Emphasized" icon="sap-icon://filter" press=".onApplyFilters" busy="{view>/loading}"/>
        </OverflowToolbar>

        <List items="{view>/zoneSummaries}" showSeparators="None" class="zoneCardList">
          <CustomListItem type="Active" press=".onZonePress" class="zoneSummaryCard">
            <customData><core:CustomData key="zoneId" value="{view>zoneId}"/></customData>
            <VBox width="100%">
              <HBox justifyContent="SpaceBetween" alignItems="Start">
                <VBox>
                  <Title text="{view>name}" level="H4"/>
                  <Text text="{view>meta}" class="zoneMeta"/>
                </VBox>
                <ObjectStatus text="{view>riskText}" state="{view>state}" inverted="true"/>
              </HBox>
              <HBox justifyContent="SpaceBetween" alignItems="End" class="zoneMetricRow">
                <VBox>
                  <ObjectNumber number="{view>attendance}" unit="% asistencia" state="{view>state}"/>
                  <Text text="{view>incidentSummary}" class="zoneIncidentSummary"/>
                </VBox>
                <ObjectStatus text="{view>inefficiencyText}" state="{view>state}"/>
              </HBox>
            </VBox>
          </CustomListItem>
        </List>

        <Panel headerText="Ineficiencia por zona (%)" class="dashboardPanel inefficiencyPanel overviewBalancedPanel sapUiSmallMarginTop">
          <content>
            <viz:VizFrame id="inefficiencyChart" vizType="stacked_bar" width="100%" height="14rem" selectData=".onZoneChartSelect">
              <viz:dataset>
                <viz.data:FlattenedDataset data="{view>/zoneInefficiency}">
                  <viz.data:dimensions><viz.data:DimensionDefinition name="Zona" value="{view>zone}"/></viz.data:dimensions>
                  <viz.data:measures>
                    <viz.data:MeasureDefinition name="Ausencias" value="{view>absentRate}"/>
                    <viz.data:MeasureDefinition name="Retardos" value="{view>lateRate}"/>
                  </viz.data:measures>
                </viz.data:FlattenedDataset>
              </viz:dataset>
              <viz:feeds>
                <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Ausencias,Retardos"/>
                <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Zona"/>
              </viz:feeds>
            </viz:VizFrame>
            <Text text="Las barras muestran ausencias y retardos por zona." class="chartHint"/>
          </content>
        </Panel>

        <l:Grid defaultSpan="XL7 L7 M12 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMarginTop overviewSecondaryGrid">
          <Panel headerText="{= 'Tendencia de incidencias · ' + ${view>/periodLabel}}" class="dashboardPanel incidentTrendPanel overviewBalancedPanel">
            <content>
              <viz:VizFrame id="incidentTrendChart" vizType="line" width="100%" height="14rem">
                <viz:dataset>
                  <viz.data:FlattenedDataset data="{view>/incidentTrend}">
                    <viz.data:dimensions><viz.data:DimensionDefinition name="Día" value="{view>day}"/></viz.data:dimensions>
                    <viz.data:measures>
                      <viz.data:MeasureDefinition name="Retardos" value="{view>late}"/>
                      <viz.data:MeasureDefinition name="Ausencias" value="{view>absent}"/>
                      <viz.data:MeasureDefinition name="Fuera de zona" value="{view>outsideZone}"/>
                      <viz.data:MeasureDefinition name="Salida anticipada" value="{view>earlyExit}"/>
                    </viz.data:measures>
                  </viz.data:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                  <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Retardos,Ausencias,Fuera de zona,Salida anticipada"/>
                  <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Día"/>
                </viz:feeds>
              </viz:VizFrame>
            </content>
          </Panel>
          <Panel headerText="Retardos y salidas anticipadas" class="dashboardPanel criticalCentersPanel overviewBalancedPanel">
            <layoutData><l:GridData span="XL5 L5 M12 S12"/></layoutData>
            <content>
              <HBox justifyContent="SpaceAround" width="100%" class="sapUiSmallMarginTop sapUiSmallMarginBottom">
                <VBox alignItems="Center" class="sapUiSmallMargin">
                  <Title text="Retardos" level="H4"/>
                  <ObjectNumber number="{view>/lateCount}" state="Warning"/>
                  <Text text="Total del periodo"/>
                </VBox>
                <VBox alignItems="Center" class="sapUiSmallMargin">
                  <Title text="Salidas anticipadas" level="H4"/>
                  <ObjectNumber number="{view>/earlyExitCount}" state="Information"/>
                  <Text text="{view>/earlyExitNote}" wrapping="true"/>
                </VBox>
              </HBox>
            </content>
          </Panel>
        </l:Grid>
      </VBox>
    </content>
  </Page>
</mvc:View>
