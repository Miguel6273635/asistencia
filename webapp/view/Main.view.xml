<mvc:View
    controllerName="com.mitsu.monitorasistencia.controller.Main"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt">
    <tnt:ToolPage id="toolPage" class="monitorToolPage">
        <tnt:header>
            <tnt:ToolHeader id="mainToolHeader" visible="{ui>/showAppHeader}" class="monitorHeader">
                <Button
                    id="headerMenuButton"
                    icon="sap-icon://menu2"
                    type="Transparent"
                    tooltip="Expandir o contraer menú"
                    press=".onToggleSideNavigation" />
                <ToolbarSeparator id="headerBrandSeparator" />
                <core:Icon id="headerBrandIcon" src="sap-icon://history" class="brandAvatar" />
                <Title id="headerTitle" text="Monitor de Asistencia" level="H2" class="monitorBrandTitle" />
                <ToolbarSpacer id="headerSpacer" />
                <ObjectStatus
                    id="demoDataStatus"
                    text="Datos de demostración"
                    icon="sap-icon://database"
                    state="Information"
                    class="sapUiSmallMarginEnd" />
                <Button id="notificationsButton" icon="sap-icon://bell" type="Transparent" tooltip="Notificaciones" />
                <Avatar id="administratorAvatar" initials="AD" displaySize="XS" class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
                <Text id="administratorText" text="Administrador" />
            </tnt:ToolHeader>
        </tnt:header>

        <tnt:sideContent>
            <tnt:SideNavigation
                id="sideNavigation"
                expanded="{ui>/sideExpanded}"
                itemSelect=".onNavigationItemSelect">
                <tnt:item>
                    <tnt:NavigationList id="navigationList" selectedKey="overview">
                        <tnt:NavigationListItem
                            id="navToggleItem"
                            key="toggleMenu"
                            text="{= ${ui>/sideExpanded} ? 'Contraer menú' : 'Expandir menú' }"
                            icon="sap-icon://menu2" />
                        <tnt:NavigationListItem id="navOverviewItem" key="overview" text="Resumen" icon="sap-icon://home" />
                        <tnt:NavigationListItem id="navShiftsItem" key="shifts" text="Turnos y horarios" icon="sap-icon://appointment-2" />
                        <tnt:NavigationListItem id="navRecordsItem" key="records" text="Registros" icon="sap-icon://table-view" />
                        <tnt:NavigationListItem id="navMapItem" key="map" text="Mapa de personal" icon="sap-icon://map-2" />
                        <tnt:NavigationListItem id="navUsersItem" key="users" text="Usuarios" icon="sap-icon://group" />
                        <tnt:NavigationListItem id="navCentersItem" key="centers" text="Centros de trabajo" icon="sap-icon://building" />
                    </tnt:NavigationList>
                </tnt:item>
                <tnt:fixedItem>
                    <tnt:NavigationList id="fixedNavigationList">
                        <tnt:NavigationListItem id="navSettingsItem" key="settings" text="Configuración" icon="sap-icon://action-settings" />
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <VBox id="mainContentLayout" fitContainer="true" class="monitorMainContentLayout">
                <App
                    id="app"
                    busyIndicatorDelay="0"
                    width="100%"
                    height="100%"
                    class="monitorMainApp">
                    <layoutData>
                        <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0%" />
                    </layoutData>
                </App>
                <HBox
                    id="globalClock"
                    class="monitorGlobalClock"
                    alignItems="Center"
                    justifyContent="End"
                    visible="{= !${ui>/showAppHeader} &amp;&amp; ${ui>/showGlobalClock} }"
                    tooltip="Hora local de Ciudad de México">
                    <core:Icon id="globalClockIcon" src="sap-icon://history" class="monitorClockMainIcon" />
                    <VBox id="globalClockDateBlock" class="monitorClockDateBlock">
                        <Text id="globalClockWeekday" text="{ui>/clockWeekday}" class="monitorClockWeekday" />
                        <Text id="globalClockDate" text="{ui>/clockDate}" class="monitorClockDate" />
                    </VBox>
                    <VBox id="globalClockDivider" class="monitorClockDivider" />
                    <HBox id="globalClockTimeRow" alignItems="End" class="monitorClockTimeRow">
                        <Text id="globalClockTime" text="{ui>/clockTime}" class="monitorClockTime" />
                        <Text id="globalClockSecondsSeparator" text="." class="monitorClockSecondsSeparator" />
                        <Text id="globalClockSeconds" text="{ui>/clockSeconds}" class="monitorClockSeconds" />
                    </HBox>
                </HBox>
            </VBox>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
