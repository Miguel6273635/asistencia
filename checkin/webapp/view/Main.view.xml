<mvc:View controllerName="com.mitsu.checkin.controller.Main" height="100%"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:tnt="sap.tnt">
  <VBox fitContainer="true" class="checkinRoot">
    <tnt:ToolPage id="toolPage" class="monitorToolPage checkinToolPage">
    <tnt:header>
      <tnt:ToolHeader class="monitorHeader">
        <Button icon="sap-icon://nav-back" type="Transparent" tooltip="Regresar" />
        <ToolbarSeparator />
        <Avatar displayShape="Square" displaySize="XS" src="sap-icon://employee-approvals" class="brandAvatar" />
        <Title text="Checkin" level="H2" class="monitorBrandTitle" />
        <Button icon="sap-icon://slim-arrow-down" type="Transparent" tooltip="Opciones de la aplicación" />
        <ToolbarSpacer />
        <Button text="Recargar datos" icon="sap-icon://refresh" type="Transparent" press=".onRefreshData"
          enabled="{= !${app>/employeeLoading} &amp;&amp; !${app>/historyLoading} }" tooltip="Actualizar empleado y marcajes desde SAP" />
        <Button text="Cerrar sesión" icon="sap-icon://log" type="Transparent" press=".onLogout"
          tooltip="Cerrar la sesión actual de Work Zone" />
        <Avatar initials="{attendance>/employee/initials}" displaySize="XS" />
      </tnt:ToolHeader>
    </tnt:header>
    <tnt:sideContent>
      <tnt:SideNavigation id="sideNavigation" expanded="{ui>/sideExpanded}" itemSelect=".onNavigationItemSelect">
        <tnt:item>
          <tnt:NavigationList id="navigationList" selectedKey="attendance">
            <tnt:NavigationListItem id="navToggleItem" key="toggleMenu" text="{= ${ui>/sideExpanded} ? 'Contraer menú' : 'Expandir menú' }" icon="sap-icon://menu2" />
            <tnt:NavigationListItem id="navAttendanceItem" key="attendance" text="Mi Asistencia" icon="sap-icon://home" />
          </tnt:NavigationList>
        </tnt:item>
      </tnt:SideNavigation>
    </tnt:sideContent>
    <tnt:mainContents>
      <App busy="{app>/busy}">
        <Page showHeader="false" class="checkinPage">
          <content>
            <VBox class="appShell compactShell">
              <VBox id="welcomeCard" class="welcomeCard compactWelcome" busy="{app>/employeeLoading}" busyIndicatorDelay="0">
                <HBox class="welcomeTop" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                  <HBox alignItems="Center" class="employeeBlock">
                    <Avatar initials="{attendance>/employee/initials}" displaySize="M" class="employeeAvatar" />
                    <VBox>
                      <Text text="Colaborador" class="welcomeLabel" />
                      <Title text="{= ${attendance>/employee/name} || 'Esperando respuesta de SAP' }" level="H1" class="employeeName" />
                      <HBox visible="{= !!${attendance>/employee/id} }" alignItems="Center" wrap="Wrap" class="employeeMeta">
                        <core:Icon src="sap-icon://employee" /><Text text="{attendance>/employee/id}" />
                        <Text text="·" class="metaDot" /><core:Icon src="sap-icon://building" /><Text text="{attendance>/employee/center}" />
                        <Text text="·" class="metaDot" /><core:Icon src="sap-icon://badge" /><Text text="{attendance>/employee/position}" />
                      </HBox>
                    </VBox>
                  </HBox>
                  <VBox alignItems="End" class="todayClock">
                    <Text text="{attendance>/today/dateText}" class="clockDate" />
                    <Title text="{attendance>/today/currentTime}" level="H1" />
                  </VBox>
                </HBox>
                <MessageStrip visible="{= !!${app>/employeeError} }" text="{app>/employeeError}" type="Error" showIcon="true" />
              </VBox>

              <VBox id="attendanceView" class="singleScreenView">
                <HBox class="singleScreenGrid" alignItems="Stretch" wrap="Wrap">
                  <VBox class="panel attendancePanel compactAttendancePanel">
                    <HBox class="panelHeading" alignItems="Center">
                      <core:Icon src="sap-icon://time-entry-request" />
                      <VBox><Title text="Registro de asistencia" level="H2" /><Text text="Selecciona la acción correspondiente a tu jornada" class="mutedText" /></VBox>
                    </HBox>
                    <HBox class="timeline" justifyContent="SpaceBetween" wrap="NoWrap">
                      <VBox id="stepEntry" class="timeStep" alignItems="Center"><VBox class="stepIcon"><core:Icon src="sap-icon://log" /></VBox><Text text="Entrada" class="stepLabel" /><Title text="{attendance>/today/entry}" level="H3" /><Text text="Pendiente" class="stepState" /></VBox>
                      <VBox id="connectorEntry" class="stepConnector" />
                      <VBox id="stepMealStart" class="timeStep" alignItems="Center"><VBox class="stepIcon"><core:Icon src="sap-icon://meal" /></VBox><Text text="Inicio de comida" class="stepLabel" /><Title text="{attendance>/today/mealStart}" level="H3" /><Text text="Pendiente" class="stepState" /></VBox>
                      <VBox id="connectorMealStart" class="stepConnector" />
                      <VBox id="stepMealEnd" class="timeStep" alignItems="Center"><VBox class="stepIcon"><core:Icon src="sap-icon://meal" /></VBox><Text text="Fin de comida" class="stepLabel" /><Title text="{attendance>/today/mealEnd}" level="H3" /><Text text="Pendiente" class="stepState" /></VBox>
                      <VBox id="connectorMealEnd" class="stepConnector" />
                      <VBox id="stepExit" class="timeStep" alignItems="Center"><VBox class="stepIcon"><core:Icon src="sap-icon://log" /></VBox><Text text="Salida" class="stepLabel" /><Title text="{attendance>/today/exit}" level="H3" /><Text text="Pendiente" class="stepState" /></VBox>
                    </HBox>
                    <MessageStrip visible="{= !!${attendance>/today/validationMessage} }"
                      text="{attendance>/today/validationMessage}" type="{attendance>/today/validationType}"
                      showIcon="true" class="validationStrip" />
                    <HBox class="markActions" wrap="Wrap">
                      <Button id="checkInAction" text="{attendance>/today/checkInText}" icon="sap-icon://log" type="Emphasized" press=".onCheckIn" />
                      <Button id="lateJustificationAction" text="{attendance>/today/lateJustificationButtonText}" icon="sap-icon://notes"
                        type="Attention" visible="{= ${attendance>/today/nextAction} === 'CHECK_IN' }"
                        enabled="{attendance>/today/isLateNow}"
                        tooltip="{= ${attendance>/today/isLateNow} ? 'Capturar la justificación del retraso' : 'Se habilitará si la entrada se registra después del inicio del horario' }"
                        press=".onOpenLateJustification" />
                      <Button id="mealStartAction" text="Iniciar comida" icon="sap-icon://meal" enabled="false" press=".onMealStart" />
                      <Button id="mealEndAction" text="Finalizar comida" icon="sap-icon://meal" enabled="false" press=".onMealEnd" />
                      <Button id="checkOutAction" text="{attendance>/today/checkOutText}" icon="sap-icon://log" enabled="false" press=".onCheckOut" />
                      <Button id="earlyExitJustificationAction" text="{attendance>/today/earlyExitJustificationButtonText}"
                        icon="sap-icon://notes" type="Attention"
                        visible="{= ${attendance>/today/canCheckOut} &amp;&amp; ${attendance>/today/isEarlyExit} }"
                        tooltip="Capturar el motivo de la salida anticipada"
                        press=".onOpenEarlyExitJustification" />
                    </HBox>
                    <MessageStrip visible="{= !!${app>/historyError} }" text="{app>/historyError}" type="Error" showIcon="true" />
                    <MessageStrip text="Cada marcaje usa una ubicación reciente y precisa del dispositivo; no se utilizan coordenadas fijas. Si la precisión no es suficiente, el evento no se enviará a SAP." type="Information" showIcon="true" class="privacyStrip" />
                  </VBox>

                  <VBox class="panel compactEmployeePanel" busy="{app>/employeeLoading}" busyIndicatorDelay="0">
                    <HBox class="panelHeading" alignItems="Center">
                      <core:Icon src="sap-icon://employee" />
                      <VBox>
                        <Title text="Datos del colaborador" level="H2" />
                        <Text text="Información laboral y asignación" class="mutedText" />
                      </VBox>
                    </HBox>

                    <HBox class="compactProfileGroups" alignItems="Stretch" wrap="Wrap">
                      <VBox class="compactProfileGroup">
                        <HBox class="compactProfileTitle" alignItems="Center">
                          <core:Icon src="sap-icon://employee" />
                          <Title text="Información laboral" level="H3" />
                        </HBox>
                        <HBox class="compactProfileField" justifyContent="SpaceBetween"><Text text="Núm. de empleado" /><Text text="{attendance>/employee/id}" wrapping="false" class="strongText compactProfileValue" /></HBox>
                        <HBox class="compactProfileField" justifyContent="SpaceBetween"><Text text="Correo" /><Text text="{attendance>/employee/email}" wrapping="true" class="strongText compactProfileValue" /></HBox>
                        <HBox class="compactProfileField" justifyContent="SpaceBetween"><Text text="Puesto" /><Text text="{attendance>/employee/position}" wrapping="true" class="strongText compactProfileValue" /></HBox>
                        <HBox class="compactProfileField" justifyContent="SpaceBetween"><Text text="Centro" /><Text text="{attendance>/employee/center}" wrapping="true" class="strongText compactProfileValue" /></HBox>
                      </VBox>

                      <VBox class="compactProfileGroup scheduleProfileGroup">
                        <HBox class="compactProfileTitle" alignItems="Center">
                          <core:Icon src="sap-icon://calendar" />
                          <Title text="Horario de hoy" level="H3" />
                        </HBox>
                        <HBox class="compactProfileField" justifyContent="SpaceBetween"><Text text="Fecha" /><Text text="{attendance>/today/dateText}" wrapping="true" class="strongText compactProfileValue" /></HBox>
                        <HBox class="compactProfileField" justifyContent="SpaceBetween"><Text text="Turno" /><Text text="{= ${attendance>/employee/schedule} || ${attendance>/schedule/name} || 'Pendiente de SAP' }" wrapping="true" class="strongText compactProfileValue" /></HBox>
                        <HBox class="compactProfileField" justifyContent="SpaceBetween"><Text text="Jornada" /><Text text="{= ${attendance>/schedule/start} &amp;&amp; ${attendance>/schedule/end} ? ${attendance>/schedule/start} + ' – ' + ${attendance>/schedule/end} : 'Pendiente de SAP' }" wrapping="false" class="strongText compactProfileValue" /></HBox>
                        <HBox class="compactProfileField" justifyContent="SpaceBetween"><Text text="Base" /><Text text="{attendance>/employee/centerCode}" wrapping="true" class="strongText compactProfileValue" /></HBox>
                        <HBox class="compactProfileField" justifyContent="SpaceBetween"><Text text="Zona" /><Text text="{attendance>/employee/zone}" wrapping="true" class="strongText compactProfileValue" /></HBox>
                      </VBox>
                    </HBox>

                    <MessageStrip visible="{= !!${app>/employeeError} }" text="{app>/employeeError}" type="Error" showIcon="true" />
                  </VBox>
                </HBox>
              </VBox>

            </VBox>
          </content>
        </Page>
      </App>
    </tnt:mainContents>
    </tnt:ToolPage>
  </VBox>
</mvc:View>
