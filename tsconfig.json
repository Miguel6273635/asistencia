{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@sapui5/types"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "./webapp",
    "paths": {
      "com/mitsu/monitorasistencia/*": ["./webapp/*"]
    }
  },
  "include": ["./webapp/**/*"]
}
    